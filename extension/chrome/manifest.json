{
  "manifest_version": 3,
  "name": "Crosspond",
  "version": "0.0.1",
  "description": "Lets Crosspond read and operate Chromium tabs through the Chrome DevTools Protocol.",
  "key": "",
  "permissions": ["nativeMessaging", "debugger", "tabs", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Crosspond",
    "default_popup": "popup.html"
  }
}
