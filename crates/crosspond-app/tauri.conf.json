{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crosspond",
  "version": "0.0.1",
  "identifier": "com.crosspond.app",
  "build": {
    "beforeDevCommand": {
      "script": "bash scripts/stage-chrome-host.sh && npm --prefix ui run dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "bash scripts/stage-chrome-host.sh --release && npm --prefix ui run build",
      "cwd": "../.."
    },
    "frontendDist": "../../ui/build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Crosspond",
        "url": "/",
        "width": 640,
        "height": 108,
        "minWidth": 400,
        "minHeight": 108,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../extension/chrome": "chrome-extension"
    },
    "externalBin": ["binaries/crosspond-chrome-host"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "../../resources/macos/Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNUYxMTdCOTE4NzIwMDQKUldRRUlJZVJleEZmNHI2ZjNJVFMwUHJQMmoxNEtTTG1zamN3VXg0MVFDNS9yYis4WERKM0F6eGwK",
      "endpoints": [
        "https://github.com/crcrworks/crosspond/releases/latest/download/latest.json"
      ]
    }
  }
}
