{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crosspond",
  "version": "0.0.1",
  "identifier": "com.crosspond.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Crosspond",
        "url": "/",
        "width": 640,
        "height": 72,
        "minWidth": 400,
        "minHeight": 72,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "../../resources/macos/Info.plist"
    }
  }
}
